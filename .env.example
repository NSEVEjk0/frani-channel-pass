# Frani Channel Pass — configuration
# Copy to .env and adjust. All values default to testnet2.

# Network. Must be testnet2. Do not point this at mainnet.
CHANNEL_NETWORK=testnet2

# Where the wallet keys and state live on disk.
CHANNEL_DATA_DIR=./wallet-data

# testnet2 wallet-api base URL.
CHANNEL_WALLET_API=https://wallet-api.unicity.network

# Public testnet2 oracle key (not a secret).
CHANNEL_ORACLE_KEY=sk_ddc3cfcc001e4a28ac3fad7407f99590

# Stable per-machine device id for the wallet-api session.
CHANNEL_DEVICE_ID=frani-channel-1

# Optional @nametag to register on first run (leave blank to skip).
CHANNEL_NAMETAG=

# Channel state file (members + posts).
CHANNEL_STATE=./channel-data/state.json

# Channel display name.
CHANNEL_NAME=Frani Channel

# Pass price (whole UCT) and how many days it grants.
CHANNEL_PASS_PRICE_UCT=5
CHANNEL_PASS_DAYS=30

# Teaser shown to unpaid users.
CHANNEL_TEASER=A members-only post just went out. Send "join" to get a pass and read the full channel.
